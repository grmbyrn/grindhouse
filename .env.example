NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/proshop
# At least 32 random characters; the server refuses to start in production otherwise.
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_APP_SECRET=your_paypal_sandbox_secret
# Use https://api-m.paypal.com for live payments
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAGINATION_LIMIT=8
# Image uploads (required in production; locally, uploads fall back to ./uploads without them).
# Free account: https://cloudinary.com, values are on the dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Password for admin@email.com when running npm run data:import. Keep it private.
SEED_ADMIN_PASSWORD=choose_a_long_private_password
